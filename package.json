{
  "publisher": "heaths",
  "name": "azure-api-review",
  "version": "0.4.0",
  "preview": true,
  "displayName": "Azure API Review",
  "description": "Adds some capabilities from APIView.dev for Azure API reviews to support the new API Review Hub.",
  "icon": "assets/icon.png",
  "license": "MIT",
  "homepage": "https://github.com/heaths/api-review",
  "repository": {
    "type": "git",
    "url": "https://github.com/heaths/api-review.git"
  },
  "bugs": {
    "url": "https://github.com/heaths/api-review/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "azure",
    "api",
    "review"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "extensionDependencies": [
    "vscode.github-authentication"
  ],
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "heaths.azureApiReview.preview.approvePullRequest",
        "title": "Approve",
        "shortTitle": "Approve",
        "category": "Azure API Review",
        "icon": "$(pass)",
        "enablement": "activeCustomEditorId == 'heaths.azureApiReview.preview' && heaths.azureApiReview.preview.inPullRequest"
      },
      {
        "command": "heaths.azureApiReview.preview.rejectPullRequest",
        "title": "Reject",
        "shortTitle": "Reject",
        "category": "Azure API Review",
        "icon": "$(error)",
        "enablement": "activeCustomEditorId == 'heaths.azureApiReview.preview' && heaths.azureApiReview.preview.inPullRequest"
      },
      {
        "command": "heaths.azureApiReview.preview.showDiff",
        "title": "Show Diff",
        "shortTitle": "Diff",
        "category": "Azure API Review",
        "icon": "$(diff)",
        "enablement": "activeCustomEditorId == 'heaths.azureApiReview.preview' && heaths.azureApiReview.preview.diffAvailable"
      },
      {
        "command": "heaths.azureApiReview.preview.nextDiffHunk",
        "title": "Next Diff Hunk",
        "shortTitle": "Next Diff Hunk",
        "category": "Azure API Review",
        "icon": "$(arrow-down)",
        "enablement": "activeCustomEditorId == 'heaths.azureApiReview.preview' && heaths.azureApiReview.preview.diffVisible && heaths.azureApiReview.preview.canNavigateNextDiff"
      },
      {
        "command": "heaths.azureApiReview.preview.previousDiffHunk",
        "title": "Previous Diff Hunk",
        "shortTitle": "Previous Diff Hunk",
        "category": "Azure API Review",
        "icon": "$(arrow-up)",
        "enablement": "activeCustomEditorId == 'heaths.azureApiReview.preview' && heaths.azureApiReview.preview.diffVisible && heaths.azureApiReview.preview.canNavigatePreviousDiff"
      },
      {
        "command": "heaths.azureApiReview.preview.closeDiff",
        "title": "Close Diff",
        "shortTitle": "Close Diff",
        "category": "Azure API Review",
        "icon": {
          "light": "assets/codicons/light/close-diff.svg",
          "dark": "assets/codicons/dark/close-diff.svg"
        },
        "enablement": "activeCustomEditorId == 'heaths.azureApiReview.preview' && heaths.azureApiReview.preview.diffAvailable"
      },
      {
        "command": "heaths.azureApiReview.preview.showComments",
        "title": "Show all documentation",
        "category": "Azure API Review",
        "icon": {
          "light": "assets/codicons/light/expand-all-docs.svg",
          "dark": "assets/codicons/dark/expand-all-docs.svg"
        }
      },
      {
        "command": "heaths.azureApiReview.preview.hideComments",
        "title": "Hide all documentation",
        "category": "Azure API Review",
        "icon": {
          "light": "assets/codicons/light/collapse-all-docs.svg",
          "dark": "assets/codicons/dark/collapse-all-docs.svg"
        }
      },
      {
        "command": "heaths.azureApiReview.preview.reopenAsText",
        "title": "Reopen as source file",
        "category": "Azure API Review",
        "icon": "$(file-code)"
      }
    ],
    "customEditors": [
      {
        "viewType": "heaths.azureApiReview.preview",
        "displayName": "Azure API Review",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "heaths.azureApiReview.preview.approvePullRequest",
          "when": "activeCustomEditorId == 'heaths.azureApiReview.preview' && !activeCustomEditorTextDiff && heaths.azureApiReview.preview.inPullRequest",
          "group": "navigation@-1000"
        },
        {
          "command": "heaths.azureApiReview.preview.rejectPullRequest",
          "when": "activeCustomEditorId == 'heaths.azureApiReview.preview' && !activeCustomEditorTextDiff && heaths.azureApiReview.preview.inPullRequest",
           "group": "navigation@-999"
        },
        {
          "command": "heaths.azureApiReview.preview.showDiff",
          "when": "activeCustomEditorId == 'heaths.azureApiReview.preview' && !activeCustomEditorTextDiff && !heaths.azureApiReview.preview.diffVisible",
           "group": "navigation@-998"
        },
        {
          "command": "heaths.azureApiReview.preview.nextDiffHunk",
          "when": "activeCustomEditorId == 'heaths.azureApiReview.preview' && !activeCustomEditorTextDiff && heaths.azureApiReview.preview.diffVisible",
           "group": "navigation@-998"
        },
        {
          "command": "heaths.azureApiReview.preview.previousDiffHunk",
          "when": "activeCustomEditorId == 'heaths.azureApiReview.preview' && !activeCustomEditorTextDiff && heaths.azureApiReview.preview.diffVisible",
           "group": "navigation@-997"
        },
        {
          "command": "heaths.azureApiReview.preview.closeDiff",
          "when": "activeCustomEditorId == 'heaths.azureApiReview.preview' && !activeCustomEditorTextDiff && heaths.azureApiReview.preview.diffVisible",
           "group": "navigation@-996",
          "toggled": "heaths.azureApiReview.preview.diffVisible"
        },
        {
          "command": "heaths.azureApiReview.preview.showComments",
          "when": "activeCustomEditorId == 'heaths.azureApiReview.preview' && heaths.azureApiReview.preview.hasComments && !heaths.azureApiReview.preview.commentsVisible",
           "group": "navigation@-995"
        },
        {
          "command": "heaths.azureApiReview.preview.hideComments",
          "when": "activeCustomEditorId == 'heaths.azureApiReview.preview' && heaths.azureApiReview.preview.hasComments && heaths.azureApiReview.preview.commentsVisible",
           "group": "navigation@-995"
        },
        {
          "command": "heaths.azureApiReview.preview.reopenAsText",
          "when": "activeCustomEditorId == 'heaths.azureApiReview.preview' && !activeCustomEditorTextDiff",
           "group": "navigation@-994"
        }
      ],
      "commandPalette": [
        {
          "command": "heaths.azureApiReview.preview.showDiff",
          "when": "false"
        },
        {
          "command": "heaths.azureApiReview.preview.approvePullRequest",
          "when": "false"
        },
        {
          "command": "heaths.azureApiReview.preview.rejectPullRequest",
          "when": "false"
        },
        {
          "command": "heaths.azureApiReview.preview.nextDiffHunk",
          "when": "false"
        },
        {
          "command": "heaths.azureApiReview.preview.previousDiffHunk",
          "when": "false"
        },
        {
          "command": "heaths.azureApiReview.preview.closeDiff",
          "when": "false"
        },
        {
          "command": "heaths.azureApiReview.preview.showComments",
          "when": "false"
        },
        {
          "command": "heaths.azureApiReview.preview.hideComments",
          "when": "false"
        },
        {
          "command": "heaths.azureApiReview.preview.reopenAsText",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Azure API Review",
      "properties": {
        "heaths.azureApiReview.files.include": {
          "type": "array",
          "scope": "resource",
          "default": [
            "**/api/API.md"
          ],
          "items": {
            "type": "string"
          },
          "description": "Workspace-relative API Markdown glob patterns. Supports `${workspaceFolder}` and `${workspaceFolder:<name>}` variables."
        },
        "heaths.azureApiReview.files.comments": {
          "type": "array",
          "scope": "resource",
          "default": [
            "API.comments.diff",
            "API.comments.patch"
          ],
          "items": {
            "type": "string"
          },
          "description": "Ordered comment patch patterns resolved relative to each API Markdown file. Supports file-context variables like `${fileBasename}`."
        },
        "heaths.azureApiReview.files.sourceMaps": {
          "type": "array",
          "scope": "resource",
          "default": [
            "API.md.map"
          ],
          "items": {
            "type": "string"
          },
          "description": "Ordered source map patterns resolved relative to each API Markdown file. Supports file-context variables like `${fileBasename}`."
        },
        "heaths.azureApiReview.git.tags": {
          "type": "array",
          "scope": "resource",
          "default": [
            "^[\\w-]+@(?<version>.+)$"
          ],
          "items": {
            "type": "string"
          },
          "description": "Ordered tag regexes used to extract versions for diff history. Use named capture `version` or capture group 1, for example `^[\\\\w-]+@(?<version>.+)$` for `crate@1.2.3` tags."
        }
      }
    }
  },
  "engines": {
    "vscode": "^1.136.0"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.1",
    "octokit": "^5.0.5",
    "source-map-js": "^1.2.1"
  },
  "devDependencies": {
    "@types/assert": "^1.5.11",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.136.0",
    "@types/webpack-env": "^1.18.8",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.9.2",
    "assert": "^2.1.0",
    "eslint": "^10.10.0",
    "express": "^5.2.1",
    "git-cliff": "^2.13.1",
    "markdownlint-cli2": "^0.23.2",
    "mocha": "^11.8.0",
    "playwright": "^1.63.0",
    "process": "^0.11.10",
    "sharp": "^0.35.4",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.6"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:headless": "vscode-test-web --browserType=chromium --headless --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js .",
    "pretest": "pnpm run compile:web",
    "vscode:prepublish": "pnpm run generate:changelog && pnpm run compile -- --mode production --devtool hidden-source-map",
    "generate:icon": "node scripts/generate-icon.mjs",
    "generate:changelog": "rm -f CHANGELOG.md && (git-cliff --bump --output CHANGELOG.md || [ -s CHANGELOG.md ])",
    "version:next": "git-cliff --bumped-version",
    "update-icons": "node scripts/update-icons.mjs",
    "precompile": "pnpm run generate:icon",
    "compile": "webpack",
    "precompile:node": "pnpm run generate:icon",
    "compile:node": "webpack --config-name node",
    "precompile:web": "pnpm run generate:icon",
    "compile:web": "webpack --config-name web",
    "prewatch:web": "pnpm run generate:icon",
    "watch:web": "webpack --config-name web --watch",
    "package:vsix": "version=$(pnpm run -s version:next) && version=${version#v} && vsce package \"$version\" --no-dependencies --no-update-package-json --no-git-tag-version",
    "publish": "version=$(pnpm run -s version:next) && version=${version#v} && vsce publish \"$version\" --no-dependencies -m \"chore(release): release %s\"",
    "lint": "eslint src",
    "run-in-browser": "node scripts/run-in-browser.mjs"
  }
}
